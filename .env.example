# Curl Commander — Environment Configuration
#
# VITE_API_BASE — Base origin for API requests (leave empty for same-origin dynamic resolution)
VITE_API_BASE=

# VITE_PROXY_URL — Dumb CORS Proxy forwarder endpoint
VITE_PROXY_URL=/proxy

# VITE_DASHBOARD_URL — Link to Cloud Dashboard
VITE_DASHBOARD_URL=/app
